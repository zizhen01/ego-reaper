<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ego-reaper</string>
  <key>ProgramArguments</key>
  <array>
    <!-- EDIT: absolute path to your node binary (launchd does not read your shell PATH) -->
    <string>/usr/local/bin/node</string>
    <!-- EDIT: absolute path to ego-reaper.mjs -->
    <string>/absolute/path/to/ego-reaper/ego-reaper.mjs</string>
  </array>
  <!-- Every 10 minutes. The script no-ops instantly when ego lite isn't running. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- EDIT: launchd does not expand ~; use absolute paths -->
  <key>StandardOutPath</key>
  <string>/absolute/path/to/ego-reaper/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/ego-reaper/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Uncomment / adjust to tune:
    <key>EGO_REAPER_IDLE_S</key><string>7200</string>
    <key>EGO_REAPER_MAX_SPACES</key><string>8</string>
    <key>EGO_REAPER_PROTECT</key><string>^keep-</string>
    -->
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
